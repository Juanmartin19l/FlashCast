# ===== FlashCast Server =====
FLASK_ENV=production
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
TZ=America/Argentina/Buenos_Aires

# ===== Envio por socket =====
TARGET_PORT=5000
SEND_TIMEOUT=2.0
SEND_MAX_THREADS=500

# ===== PostgreSQL =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flashcast
DB_USER=flashcast
DB_PASSWORD=REEMPLAZAR_CON_PASSWORD