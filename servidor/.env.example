# ===== FlashCast Server =====
FLASK_ENV=production
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
TZ=America/Argentina/Buenos_Aires

# ===== Envio por socket =====
TARGET_PORT=5000
SEND_TIMEOUT=2.0
SEND_MAX_THREADS=500

# ===== NocoDB =====
# URL base del servidor NocoDB
# Ejemplo: http://localhost:8080 o https://nocodb.mi-dominio.com
NOCODB_BASE_URL=http://localhost:8080

# Token de API generado en NocoDB (Settings -> Tokens)
NOCODB_API_TOKEN=REEMPLAZAR_CON_TOKEN

# Para API v1:
# /api/v1/db/data/v1/{org}/{project}/{table}
NOCODB_ORG=noco
NOCODB_PROJECT=nc
NOCODB_TABLE=dispositivos

# Modo de API de NocoDB: auto | v1 | v2
# Usa v2 cuando NOCODB_TABLE es un ID interno de tabla (por ejemplo tblxxxx)
NOCODB_API_MODE=auto

# Timeout en segundos para llamadas HTTP a NocoDB
NOCODB_TIMEOUT=10
